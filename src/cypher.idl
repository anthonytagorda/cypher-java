module cypher {

    /** ─── Player (Client-side) ──────────────────────────────────────────────
    *   The client implements this interface and passes it to the server on login.
    *   The server calls these methods to push notifications to the client.
    */
    module player {
        module app {
            typedef sequence<string> strings;
            typedef sequence<long> integers;

            interface PlayerApp {
                //── Round Events ─────────────────────────────────────────────

                /**
                *   Called by server at the start of each round.
                *   'letters' is a 20-character string (13 consonants, 7 vowels)
                */
                void sendLetters(in string letters);

                /**
                 * Notifies the client that a submitted word is invalid.
                 * @param word   The rejected word.
                 * @param reason Human-readable reason (e.g., too short, not in words.txt).
                 */
                void invalidWord(in string word, in string reason);

                /**
                 * Confirms that the submitted word passed server validation.
                 * @param word The accepted word.
                 */
                void wordAccepted(in string word);

                /**
                 * Sends end-of-round standings.
                 * @param usernames    Players in the round.
                 * @param roundScores  Score per player for the round (index-aligned).
                 * @param longestWord  Longest valid word per player (index-aligned).
                 * @param roundWinner  Username of round winner; may be empty on tie.
                 * @param roundNumber  1-based round index.
                 */
                void sendRoundResult(
                    in strings usernames,
                    in integers roundScores,
                    in strings longestWord,
                    in string roundWinner,
                    in long roundNumber
                );

                /**
                 * Sends end-of-game summary.
                 * @param usernames   Players in the game.
                 * @param roundWins   Number of rounds won per player (index-aligned).
                 * @param totalScores Aggregate score per player (index-aligned).
                 * @param gameWinner  Username of eventual winner.
                 */
                void sendGameResult(
                    in strings usernames,
                    in integers roundWins,
                    in integers totalScores,
                    in string gameWinner
                );

                //── Matchmaking Events ─────────────────────────────────────────────

                /**
                 * Informs player that matchmaking has started and they are waiting.
                 * @param timeout Waiting window in seconds.
                 */
                void waitingForPlayers(in long timeout);

                /**
                 * Informs player that a game has been formed.
                 * @param gameId    Unique game identifier.
                 * @param opponents Usernames of other players in the game.
                 */
                void gameFound(in long gameId, in strings opponents);

                /**
                 * Informs player that no additional players joined in time.
                 */
                void noPlayersJoined();

                /**
                 * Informs player that another player has disconnected from the game.
                 * @param playerName Username of the disconnected player.
                 */
                void playerDisconnected(in string playerName);

                //── Admin/System Events ────────────────────────────────────────────

                 /**
                 * Notifies player that the account has been banned.
                 * Client should force logout and disable gameplay actions.
                 */
                void notifyBanned();

                 /**
                 * Notifies players that current game was forcibly stopped (e.g., admin action).
                 */
                void notifyGameStopped();
            };
        };
    };

    // ─── Server ───────────────────────────────────────────────────────────────────
    module server {
        // -------------------------------------------------------------------------
        // Runtime-configurable game settings (admin-managed).
        // -------------------------------------------------------------------------
        module config {
            struct GameConfig {
                long waitingTimeSecs;   // How long to wait for players to join a game (default: 10)
                long roundDurationSecs; // How long each round lasts in seconds (default: 30)
                long maxPlayers;        // Maximum players allowed per game
                long roundsToWin;       // How many round wins needed to win the game (default: 3)
            };
        };

        // -------------------------------------------------------------------------
        // Domain-specific exceptions for deterministic client error handling.
        // -------------------------------------------------------------------------
        module controller {
            module exceptions {
                exception InvalidCredentialsException { string message; };  // Raised when username/password do not match any record in the DB
                exception AlreadyLoggedInException { string message; };     // Raised when the player is already logged in (single session enforced)
                exception PlayerBannedException { string message; };        // Raised when the player's account has been banned by admin

                exception NoPlayersAvailableException { string message; };  // Raised when findOrCreateGame() times out with no other player joining
                exception PlayerAlreadyInQueueException { string message; };// Raised when the player calls findOrCreateGame() but is already in the queue
                exception PlayerNotInQueueException { string message; };    // Raised when the player calls cancelQueue() but was never in the queue

                exception GameAlreadyStartedException { string message; };  // Raised when attempting to start a game that has already started
                exception GameNotFoundException { string message; };        // Raised when referencing a gameId that does not exist in the DB
                exception NotInGameException { string message; };           // Raised when a player attempts a game action but is not part of that game

                exception WordTooShortException { string message; };        // Raised when submitted word is less than 4 letters
                exception InvalidWordException { string message; };         // Raised when submitted word is not found in words.txt
                exception InvalidLettersException { string message; };      // Raised when submitted word uses letters not present in the round's letter set
                exception RoundNotActiveException { string message; };      // Raised when submitted word arrives after the 30-second round timer has elapsed
            };
        };

        // ── Database Table Structures ─────────────────────────────────────────
        module tables {
            module player {
                struct Player {
                    long playerId;
                    string username;
                    string password;
                    string status;      // "online" | "offline" | "in-game"
                    boolean isBanned;   // true if admin has banned this account
                    long totalWins;
                    string createdAt;   // e.g. "2026-07-14 10:30:00"
                };
            };

            module game {
                struct Game {
                    long gameId;
                    string startTime;
                    string endTime;
                    string gameStatus;  // "waiting" | "in-progress" | "finished" | "stopped"
                    string playerWinner; // Username of the game winner, empty if game not yet finished
                };
            };

            module round {
                struct Round {
                    long roundId;
                    long gameId;
                    long roundNumber;
                    string letters;     // The 20 letters sent to players this round
                    string roundWinner; // Username of round winner, empty if tie
                };

                struct PlayerRoundScore {
                    long playerId;
                    long gameId;
                    long roundId;
                    long score;             // Sum of lengths of this player's unique valid words
                    string wordSubmitted;   // The longest unique word submitted (for leaderboard tracking)
                };
            };

            module leaderboard {
                struct Leaderboards {
                    long rank;          // Position on leaderboard e.g. 1, 2, 3, 4, 5
                    string username;    // Player username
                    long gamesPlayed;   // Number of games played
                    long gamesWon;      // Total game wins
                    long highestScore;  // Highest score earned
                    string longestWord; // Longest word ever submitted by this player

                };
                // Sequence of Leaderboards used as return type for getLeaderboard()
                typedef sequence<Leaderboards> Leaderboard;
            };
        };

        // -------------------------------------------------------------------------
        // Main server application contract.
        // -------------------------------------------------------------------------
        module app {
            interface ServerApp {
                /**
                 * Authenticates a player and registers callback for server push events.
                 * @return playerId on successful login.
                 */
                long login(in string username, in string password, in player::app::PlayerApp callback)
                    raises (controller::exceptions::InvalidCredentialsException,
                            controller::exceptions::AlreadyLoggedInException,
                            controller::exceptions::PlayerBannedException);

                /**
                 * Registers a new player account.
                 * @param username Desired unique username.
                 * @param password Plain-text or pre-hashed password (based on server policy).
                 * @return true if registration succeeds; false if username already exists or creation fails.
                 */
                boolean register(in string username, in string password);

                /**
                 * Logs out player and releases online session state.
                 */
                void logout(in long playerId);

                /**
                 * Starts a game explicitly (manual start), if it is still in waiting state.
                 * @param gameId The target game ID.
                 * @raises GameNotFoundException if the game does not exist.
                 * @raises GameAlreadyStartedException if the game is already in progress or finished.
                 */
                void startGame(in long gameId)
                    raises (controller::exceptions::GameNotFoundException,
                            controller::exceptions::GameAlreadyStartedException);

                /**
                * Searches for an existing game in "WAITING" status for the player to join.
                * If no waiting game exists, returns a Game with gameId = 0 and empty fields
                * so the client can decide whether to create a new game instead.
                * @param playerId The player attempting to join a game.
                * @return The found Game (joined), or an empty Game (gameId = 0) if none found.
                */
                tables::game::Game findNewGame(in long playerId);

                /**
                * Creates a brand new game in "WAITING" status with the given player as host,
                * and joins that player to it.
                * @param playerId The player creating and hosting the new game.
                * @return The newly created Game record.
                */
                tables::game::Game createNewGame(in long playerId);

                /**
                * Lightweight matchmaking poll used by the lobby countdown.
                * Checks whether at least one opponent has joined the player's
                * current waiting game without creating or starting a game.
                * @param playerId The player performing the check.
                * @return true if the player's current waiting game already has 2+ players (i.e. an opponent has joined); false otherwise.
                */
                boolean hasOpponentJoined(in long playerId);

                // Removes the player from the matchmaking queue before a game is found.
                void cancelQueue(in long playerId)
                    raises (controller::exceptions::PlayerNotInQueueException);

                /**
                 * Submits a word for validation in an active round.
                 */
                void submitWord(in long playerId, in long gameId, in string word)
                    raises (controller::exceptions::WordTooShortException,
                            controller::exceptions::InvalidWordException,
                            controller::exceptions::InvalidLettersException,
                            controller::exceptions::RoundNotActiveException,
                            controller::exceptions::NotInGameException);

                /**
                 * Removes player from active game context. The remaining players continue playing.
                 */
                void leaveGame(in long playerId, in long gameId)
                    raises (controller::exceptions::NotInGameException);

                /**
                 * Removes a target player from the current game and notifies them.
                 */
                void kickPlayer(in long hostPlayerId, in long targetPlayerId, in long gameId)
                    raises (controller::exceptions::NotInGameException);

                // ── Leaderboard ───────────────────────────────────────────────
                // Returns the top 5 players by total game wins.
                tables::leaderboard::Leaderboard getLeaderboard();

                // ----------------------------
                // Config management endpoints
                // ----------------------------
                config::GameConfig getGameConfig();
                void setWaitingTime(in long seconds);   // Updates the waiting time for matchmaking (in seconds).
                void setRoundDuration(in long seconds); // Updates the round duration (in seconds).
                void setMaxPlayers(in long maxPlayers); // Updates the maximum number of players allowed per game.
            };
        };
    };
};